\@writefile{toc}{\contentsline {paragraph}{No retrieval refinement is universally safe --- except the boring one.}{19}{section*.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Compare at matched budget, or measure context size by accident.}{19}{section*.41}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Report abstention, or Exact Match will lie.}{19}{section*.42}\protected@file@percent }
