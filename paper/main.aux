\@writefile{toc}{\contentsline {paragraph}{No retrieval refinement is universally safe --- except the boring one.}{18}{section*.39}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Compare at matched budget, or measure context size by accident.}{18}{section*.40}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Report abstention, or Exact Match will lie.}{18}{section*.41}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Posterior signals beat prior predictions.}{18}{section*.42}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Confidence is not a second signal --- at least not for free.}{18}{section*.43}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Report the ceiling.}{18}{section*.44}\protected@file@percent }
